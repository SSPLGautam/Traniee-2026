@model OnlineOrderProcessing.ViewModels.ProductListViewModel

@{
    ViewData["Title"] = "Product List";
}

<div class="products-container">

    <div class="products-header">

        <div>
            <h3>Products</h3>
            <p>Discover our latest collection of quality products at great price.</p>
        </div>

        <form id="search-form">

            <input asp-for="Search"
                   id="product-search"
                   placeholder="Search products using name or sku." />

            <button class="primary-btn" type="submit">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="20"
                     height="20"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="m21 21-4.34-4.34" />
                    <circle cx="11" cy="11" r="8" />

                </svg>

                Search
            </button>

        </form>

    </div>


    <div id="products-container">

        @await Html.PartialAsync("_ProductList", Model)

    </div>

</div>


@section Scripts
{
    <script src="~/js/products.js"></script>
}
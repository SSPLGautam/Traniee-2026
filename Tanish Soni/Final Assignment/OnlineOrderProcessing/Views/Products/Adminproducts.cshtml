@model OnlineOrderProcessing.ViewModels.ProductListViewModel

@{
    ViewData["Title"] = "Admin Products";
}

<div class="product-container">

    <!-- Header -->
    <div class="products-header">

        <div>
            <h3>Products</h3>
            <p>
                Manage your products, view stock levels and update details.
            </p>
        </div>

        <div class="primary-btn add-product">
            <a asp-action="Create"
               asp-controller="Products">
                + Add Product
            </a>
        </div>

    </div>


    <!-- Search -->
    <form method="get"
          asp-action="Adminproducts"
          asp-controller="Products">

        <input placeholder="Search products using name or SKU..."
               asp-for="Search" />

        <button class="primary-btn" type="submit">

            <svg xmlns="http://www.w3.org/2000/svg"
                 width="20"
                 height="20"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <path d="m21 21-4.34-4.34" />
                <circle cx="11" cy="11" r="8" />

            </svg>

            Search

        </button>

    </form>


    <!-- Products Table -->
    <table>

        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>SKU</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @if (Model.Products.Any())
            {
                var index =
                    ((Model.CurrentPage - 1) * Model.PageSize) + 1;

                foreach (var product in Model.Products)
                {
                    <tr>

                        <td>
                            @index
                        </td>

                        <td>
                            @product.Name
                        </td>

                        <td>
                            @product.SKU
                        </td>

                        <td>
                            $@product.Price
                        </td>

                        <td>
                            @product.Stock
                        </td>

                        <td class="actions">

                            <a class="edit-btn"
                               asp-action="Edit"
                               asp-controller="Products"
                               asp-route-id="@product.Id">
                                Edit
                            </a>

                            <button type="button"
                                    data-id="@product.Id"
                                    class="del-btn">
                                Del
                            </button>

                        </td>

                    </tr>

                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="6">
                        Products Not found.
                    </td>
                </tr>
            }

        </tbody>

    </table>


    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination">

            <!-- Previous -->
            @if (Model.CurrentPage > 1)
            {
                <a asp-action="Adminproducts"
                   asp-controller="Products"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   asp-route-Search="@Model.Search">
                    ← Previous
                </a>
            }


            <!-- Page Numbers -->
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a asp-action="Adminproducts"
                   asp-controller="Products"
                   asp-route-page="@i"
                   asp-route-Search="@Model.Search"
                   class="@(i == Model.CurrentPage ? "active" : "")">

                    @i

                </a>
            }


            <!-- Next -->
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-action="Adminproducts"
                   asp-controller="Products"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   asp-route-Search="@Model.Search">
                    Next →
                </a>
            }

        </div>
    }


    <!-- Delete Modal -->
    <div class="delete-container hide">

        <div class="delete">

            <h4>
                Press Delete if you want to delete this!!
            </h4>

            <div>

                <button type="button"
                        id="cancel-btn">
                    Cancel
                </button>

                <button type="button"
                        id="confirm-delete">
                    Delete
                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="~/js/adminProducts.js"></script>

}
@model OnlineOrderProcessing.ViewModels.AdminOrdersViewModel

@{
    ViewData["Title"] = "All Failed Orders";
}

<div class="admin-orders">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4>Failed Orders</h4>
            <p class="text-muted">
                Manage customer Failed Orders
            </p>
        </div>

    </div>


    <div class="card">

        <div class="card-header">

            <strong>Orders</strong>

        </div>


        <div class="table-responsive">

            <table class="table table-hover mb-0">

                <thead class="table-light">

                    <tr>

                        <th>Order</th>

                        <th>Customer</th>

                        <th>Date</th>

                        <th>Items</th>

                        <th>Total</th>

                        <th>Attempts</th>

                       

                      

                    </tr>

                </thead>


                <tbody id="ordersTable">

                    @foreach (var order in Model.Orders)
                    {
                        <tr class="order-row"
                            data-status="@order.Status">

                            <td>

                                <strong>
                                    #@order.OrderId
                                </strong>

                            </td>


                            <td>

                                <strong>
                                    @order.CustomerName
                                </strong>

                                <br />

                                <small class="text-muted">
                                    @order.CustomerEmail
                                </small>

                            </td>


                            <td>

                                @order.CreatedAt.ToString(
                                    "dd MMM yyyy")

                            </td>


                            <td>

                                @order.Items.Sum(x => x.Quantity)

                            </td>


                            <td>

                                <strong>
                                    ₹@order.TotalAmount.ToString("N2")
                                </strong>

                            </td>


                            <td>

                                @order.PaymentAttempts / 3

                            </td>


                          

                           

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
@model OnlineOrderProcessing.ViewModels.AdminOrdersViewModel

@{
    ViewData["Title"] = "All Orders";
}

<div class="admin-orders">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4>All Orders</h4>
            <p class="text-muted">
                Manage customer orders
            </p>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="message-box">
            <span id="message">@TempData["Message"]</span>
        </div>
    }

    <div class="card">

        <div class="card-header">
            <strong>Orders</strong>
        </div>

        <div class="table-responsive">

            <table class="table table-hover mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Attempts</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody id="ordersTable">

                    @if (Model.Orders != null && Model.Orders.Any())
                    {
                        @foreach (var order in Model.Orders)
                        {
                            <tr class="order-row"
                                data-status="@order.Status">

                                <td>
                                    <strong>
                                        #@order.OrderId
                                    </strong>
                                </td>

                                <td>
                                    <strong>
                                        @order.CustomerName
                                    </strong>
                                    <br />

                                    <small class="text-muted">
                                        @order.CustomerEmail
                                    </small>
                                </td>

                                <td>
                                    @order.CreatedAt.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @order.Items.Sum(x => x.Quantity)
                                </td>

                                <td>
                                    <strong>
                                        ₹@order.TotalAmount.ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    @order.PaymentAttempts / 3
                                </td>

                                <td>
                                    <form asp-controller="Orders"
                                          asp-action="UpdateStatus"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="orderId"
                                               value="@order.OrderId" />

                                        <select name="status">

                                            @foreach (var status in Model.OrderStatuses)
                                            {
                                                <option value="@status"
                                                        selected="@(status == order.Status)">
                                                    @status
                                                </option>
                                            }

                                        </select>

                                        <button type="submit"
                                                class="primary-btn">
                                            Update
                                        </button>

                                    </form>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center">
                                No orders found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="pagination">

                @if (Model.CurrentPage > 1)
                {
                    <a asp-controller="Orders"
                       asp-action="AdminOrders"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       class="pagination-link">
                        Previous
                    </a>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a asp-controller="Orders"
                       asp-action="AdminOrders"
                       asp-route-page="@i"
                       class="pagination-link @(i == Model.CurrentPage ? "active" : "")">
                        @i
                    </a>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a asp-controller="Orders"
                       asp-action="AdminOrders"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       class="pagination-link">
                        Next
                    </a>
                }

            </div>
        }

    </div>

</div>

<script>
    setTimeout(function () {
        $(".message-box").fadeOut();
    }, 4000);
</script>
@model OnlineOrderProcessing.ViewModels.LoginViewModel;
@{
    ViewData["Title"] = "Login";
}

<div class="login-container">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <form asp-action="Login" method="post">

        <div class="flex-column input gap-1">
            <label class="text-primary" asp-for="Email"></label>
            <input asp-for="Email" placeholder="Enter your email :" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="flex-column input mt-2 gap-1">
            <label class="text-primary" asp-for="Password"></label>
            <input asp-for="Password" type="password" placeholder="Enter your password :" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <button class="btn btn-primary w-100 fw-semibold py-2 mt-3 " type="submit">Sign In</button>
    </form>
</div>  
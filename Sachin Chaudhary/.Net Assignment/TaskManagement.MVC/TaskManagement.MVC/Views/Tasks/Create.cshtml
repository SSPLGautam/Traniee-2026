@model TaskManagement.MVC.ViewModels.TaskViewModel

@{
    ViewData["Title"] = "Create Task";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>
        <i class="bi bi-plus-square"></i>
        Provision New Task
    </h2>

    <a asp-action="Index" class="btn btn-secondary">
        ← Back to List
    </a>
</div>

<div class="card-box">

    <form asp-action="Create" method="post">

        <div class="mb-3">
            <label asp-for="Title" class="form-label fw-bold">
                Task Title
            </label>
            <input asp-for="Title"
                   class="form-control"
                   placeholder="Enter objective summary title" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-bold">
                Detailed Description
            </label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"
                      placeholder="Describe workflow requirements..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label fw-bold">
                Task Status
            </label>
            <select asp-for="Status" class="form-select">
                <option value="Pending">Pending</option>
                <option value="In Progress">In Progress</option>
                <option value="Completed">Completed</option>
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DueDate" class="form-label fw-bold">
                Deadline Target Date
            </label>
            <input asp-for="DueDate"
                   type="date"
                   class="form-control" />
            <span asp-validation-for="DueDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AssignedToUserId" class="form-label fw-bold">
                Assign To Employee
            </label>

            <select asp-for="AssignedToUserId" class="form-select">
                <option value="">-- Select Employee --</option>

                @if (Model.Users != null && Model.Users.Any())
                {
                    foreach (var user in Model.Users)
                    {
                        <option value="@user.Id">
                            @user.Email
                        </option>
                    }
                }
            </select>

            <span asp-validation-for="AssignedToUserId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-cloud-arrow-up"></i>
            Save Parameters
        </button>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}